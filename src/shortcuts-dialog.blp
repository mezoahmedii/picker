using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Choose an Item");
      action-name: "win.choose-element";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New File");
      action-name: "win.new-file";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Open File");
      action-name: "win.open-file";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save");
      action-name: "win.save-file";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save as");
      action-name: "win.save-file-as";
    }
  }
}
